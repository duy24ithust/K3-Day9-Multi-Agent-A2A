# Template cho .env — file này ĐƯỢC commit, .env thật thì KHÔNG.
# Copy sang .env rồi điền key:  cp .env.example .env
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional override khi dev. Model name thật vẫn phải nằm trong code + metadata.json.
LLM_MODEL=nvidia/nemotron-nano-9b-v2:free
